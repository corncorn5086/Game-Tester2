# Ember environment configuration
# Copy this file to .env and fill in real values. NEVER commit real keys.

# --- Payments ---
# PayPal is Ember's primary processor (custom in-app checkout; only the
# approval window is external). Sandbox keys: developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Braintree (unlocks Google Pay, Apple Pay and Ember-styled card fields)
# From your Braintree dashboard. Then: npm install braintree -w @ember/backend
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
BRAINTREE_ENV=sandbox
# Stripe (optional fallback — not used as the primary processor)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Database ---
# Default: local SQLite file managed by the backend (backend/data/ember.sqlite).
# Production MUST set an absolute path on a persistent mounted volume. The
# directory contains ember.sqlite plus its WAL files and must be writable.
EMBER_DATA_DIR=
# Set DATABASE_URL to migrate to Postgres/Supabase later.
DATABASE_URL=

# --- API ---
# URL of the Ember backend, used by the web site, desktop app and agent.
API_URL=http://localhost:4310

# Public backend exposure mode. `full` preserves all legacy APIs for local
# development only. Public production startup requires `managed-ai`, which
# exposes only /health, /auth/* and /ai/*.
EMBER_API_MODE=full

# --- Auth ---
# Reserved for a future signed-token deployment. Current Ember sessions are
# opaque random tokens; only their SHA-256 digests are stored server-side.
AUTH_SECRET=
# Public signup is enabled by default in development and fail-closed in
# production. Set exactly true in production only when onboarding is ready.
EMBER_PUBLIC_SIGNUP=
# Backend account-abuse guards. Raw IP addresses are never persisted.
EMBER_AUTH_SIGNUP_RATE_LIMIT=5
EMBER_AUTH_SIGNUP_RATE_WINDOW_MS=600000
EMBER_AUTH_LOGIN_RATE_LIMIT=15
EMBER_AUTH_LOGIN_RATE_WINDOW_MS=300000
EMBER_AUTH_FORGOT_PASSWORD_RATE_LIMIT=5
EMBER_AUTH_FORGOT_PASSWORD_RATE_WINDOW_MS=900000
EMBER_AUTH_RESEND_EMAIL_RATE_LIMIT=3
EMBER_AUTH_RESEND_EMAIL_RATE_WINDOW_MS=900000
EMBER_AUTH_OPERATOR_BOOTSTRAP_RATE_LIMIT=5
EMBER_AUTH_OPERATOR_BOOTSTRAP_RATE_WINDOW_MS=900000
EMBER_AUTH_RATE_LIMIT_MAX_ENTRIES=10000
# Password hashing runs on the async crypto worker pool with bounded admission.
EMBER_AUTH_SCRYPT_CONCURRENCY=2
EMBER_AUTH_SCRYPT_QUEUE_LIMIT=64
# Verification and recovery credentials are short-lived, rotated, and kept in
# a bounded persistent table. Values are milliseconds except MAX_* counts.
EMBER_AUTH_EMAIL_VERIFY_TTL_MS=600000
EMBER_AUTH_EMAIL_VERIFY_MAX_ATTEMPTS=5
EMBER_AUTH_PASSWORD_RESET_TTL_MS=1800000
EMBER_AUTH_PASSWORD_RESET_MIN_INTERVAL_MS=60000
EMBER_AUTH_TOKEN_MAX_ROWS=10000
# One-time first-operator bootstrap. Set both only on the backend, seal them,
# call POST /auth/bootstrap-operator once, then delete both and redeploy. The
# secret must contain at least 32 characters and must never enter Desktop.
EMBER_OPERATOR_BOOTSTRAP_EMAIL=
EMBER_OPERATOR_BOOTSTRAP_SECRET=

# --- Ember Agent ---
# Token used by the local agent/CLI to authenticate against the backend.
EMBER_AGENT_TOKEN=

# --- Managed AI (backend only, optional) ---
# These values belong ONLY on the Ember backend/hosting environment. Never put
# them in Ember Desktop, a packaged EXE, a project ember.config.json, or a public
# build variable. Customers do not supply provider credentials.
# The backend chooses the provider; the desktop only calls the authenticated
# Ember API. Local development may use auto with blank keys. Production must
# select openai or claude explicitly and provide its server-side key.
EMBER_AI_PROVIDER=auto
# Cost-abuse guards enforced before a provider request.
EMBER_AI_RATE_LIMIT_PER_MINUTE=12
EMBER_AI_IP_RATE_LIMIT_PER_MINUTE=24
EMBER_AI_CONCURRENCY_LIMIT=2
EMBER_AI_RATE_LIMIT_MAX_ENTRIES=10000
# Paid-provider operation budgets (summary = 1, each triage = 1).
# Production access always requires a verified Ember email account.
EMBER_AI_GLOBAL_CONCURRENCY_LIMIT=4
EMBER_AI_GLOBAL_OPERATIONS_PER_MINUTE=30
EMBER_AI_DAILY_USER_OPERATION_LIMIT=40
EMBER_AI_DAILY_GLOBAL_OPERATION_LIMIT=400
EMBER_AI_BUDGET_RETENTION_DAYS=8
# Claude Fable 5 — https://console.anthropic.com (Settings > API Keys).
ANTHROPIC_API_KEY=
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Current cost/quality default documented by OpenAI. Confirm that this model is
# enabled for the operator project before the production smoke test.
OPENAI_MODEL=gpt-5.6-terra

# --- Supabase (cloud sync) ---
SUPABASE_URL=
# Publishable/anon key — safe to expose. Production RLS denies it all table
# access, so it is used only for identifying the project.
SUPABASE_ANON_KEY=
# SERVICE ROLE key — SECRET, server-only, NEVER ship to the desktop/web client.
# The backend uses it to sync through the locked-down RLS. Get it from
# Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend server / reverse proxy ---
# Production checklist (replace values for your host; do not copy as secrets):
# Public API_URL values, non-loopback HOST values, and Railway runtime signals
# refuse to start unless NODE_ENV=production is set explicitly.
#   NODE_ENV=production
#   API_URL=https://api.example.com
#   EMBER_API_MODE=managed-ai
#   EMBER_DATA_DIR=/absolute/path/on/persistent-volume
#   EMBER_CORS_ORIGINS=https://app.example.com,https://admin.example.com
#   EMBER_TRUST_PROXY=loopback,linklocal,uniquelocal
#   EMBER_AI_PROVIDER=openai
#   OPENAI_API_KEY=<backend-secret>
# Validate the real hosting proxy chain before release. A numeric hop count is
# safe only when every route to the app has exactly that verified topology.
NODE_ENV=development
HOST=127.0.0.1
PORT=4310
EMBER_CORS_ORIGINS=*
EMBER_TRUST_PROXY=false
EMBER_SHUTDOWN_TIMEOUT_MS=15000
