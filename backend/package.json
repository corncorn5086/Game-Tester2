{
  "name": "@ember/backend",
  "version": "0.2.0",
  "private": true,
  "description": "Ember backend API — projects, test plans, runs, bugs, reports, settings, auth, billing and team, backed by SQLite (Postgres/Supabase-ready storage layer).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-missing=../.env src/server.js",
    "start": "node --env-file-if-missing=../.env src/server.js",
    "build": "node -e \"console.log('@ember/backend: nothing to build (plain ESM)')\"",
    "test": "node test/api.test.js"
  },
  "dependencies": {
    "@ember/agent": "*",
    "@ember/shared": "*",
    "braintree": "^3.29.0",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
